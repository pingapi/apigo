<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.crabc</groupId>
    <artifactId>ApiGo</artifactId>
    <version>${revision}</version>

    <packaging>pom</packaging>
    <description>接口开发平台</description>
    <modules>
        <module>apigo-api</module>
<!--        <module>apigo-spring-boot-starter</module>-->
    </modules>

    <properties>
        <!-- apigo 版本-->
        <revision>6.5.0</revision>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.2</spring-boot.version>
        <spring-boot.mybatis.version>4.1.0</spring-boot.mybatis.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <pagehelper.boot.version>4.1.1</pagehelper.boot.version>
        <spring-boot.druid.version>1.2.28</spring-boot.druid.version>
        <fastjson.version>2.0.66</fastjson.version>
        <jwt.version>0.13.0</jwt.version>
        <commons-pool2.version>2.13.1</commons-pool2.version>
        <lombok.version>1.18.48</lombok.version>
        <jdk18on.version>1.80</jdk18on.version>
        <spring-ai.version>2.0.2</spring-ai.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- 统一版本：3.13.0 起才正式支持 JDK 23+ 的 -proc:full，旧版本行为不可预期 -->
                <version>3.14.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <parameters>true</parameters>
                    <!-- JDK 23+ javac 默认禁用隐式注解处理器，Lombok 需显式开启 -->
                    <proc>full</proc>
                    <!-- 显式声明处理器路径：不依赖 classpath 扫描，避免 JDK 后续再调整隐式处理器策略 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 单测执行：统一版本，并允许 Mockito/ByteBuddy 动态加载代理。
                 JDK 21+ 默认对动态加载 agent 打印告警，后续版本会直接禁止，这里提前显式开启 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
            <!-- 构建环境闸门：JDK 版本不满足时给出明确提示，而不是晦涩的 "invalid target release" -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-jdk</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>本项目已升级到 Java 25：请用 JDK 25 构建（java -version 检查），或设置 JAVA_HOME 指向 JDK 25。</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 统一 revision 版本 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                    </execution>
                    <execution>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>